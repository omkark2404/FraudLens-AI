# .env.example — copy to .env and fill in your values
# NEVER commit .env to version control

# ── Flask ──────────────────────────────────────────────────────
SECRET_KEY=generate-a-long-random-string-here-at-least-32-chars
FLASK_DEBUG=false

# ── File uploads ───────────────────────────────────────────────
MAX_UPLOAD_MB=16

# ── Database ───────────────────────────────────────────────────
# For development: SQLite (default)
DB_NAME=ocr_jobs.db
# For production: switch to PostgreSQL (see README)

# ── OCR thresholds ─────────────────────────────────────────────
# Minimum confidence to accept an OCR block (0.0–1.0)
OCR_CONF_THRESHOLD=0.6
# Threshold for high-confidence scoring bonus
HIGH_CONF_THRESHOLD=0.75
# Number of fraud anomalies needed to flag as "Suspicious"
FRAUD_THRESHOLD=2

# ── LLM Integration (Optional) ─────────────────────────────────
# Optional: Gemini API key for LLM fallback extraction (if keyword/regex fail)
GEMINI_API_KEY=
